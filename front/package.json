{
  "name": "preptm",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --localize && gzipper compress ./dist",
    "build-optmized": "ng build --localize && gulp && gzipper compress ./dist",
    "build:prod": "ng build --configuration=production && node -e \"const fs=require('fs');fs.copyFileSync('proxy-server.mjs','dist/preptm/proxy-server.mjs');fs.copyFileSync('ecosystem.config.cjs','dist/preptm/ecosystem.config.cjs');console.log('proxy-server.mjs + ecosystem.config.cjs copied to dist')\"",
    "build:stage": "ng build --configuration=staging && node -e \"const fs=require('fs');fs.copyFileSync('proxy-server.mjs','dist/preptm/proxy-server.mjs');fs.copyFileSync('ecosystem.config.cjs','dist/preptm/ecosystem.config.cjs');console.log('proxy-server.mjs + ecosystem.config.cjs copied to dist')\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:en": "node dist/preptm/server/en/server.mjs",
    "serve:ssr:hi": "node dist/preptm/server/hi/server.mjs",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "optimize-css": "gulp --gulpfile optimize-css.gulpfile.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/ssr": "^19.0.0",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "express": "^4.18.2",
    "gulp-uglify": "^3.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/localize": "^19.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.20",
    "gulp": "^5.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-dom": "^1.0.0",
    "gulp-filter": "^9.0.1",
    "gulp-purify-css": "^0.1.0",
    "gulp-replace": "^1.1.4",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "~5.6.3"
  }
}
